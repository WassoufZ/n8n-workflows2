      "parameters": {
        "jsCode": "// Posts published 1-8 days ago, one item per post + platform.\nconst S = $('⚙️ Settings').first().json;\nconst now = $now.setZone(S.TIMEZONE);\nreturn $input.all().map((i) => i.json)\n  .filter((r) => r.post_id && ['published', 'tiktok_draft'].includes(r.status))\n  .map((r) => ({ ...r, age_days: Math.floor(now.diff(DateTime.fromISO(r.created_at), 'days').days) }))\n  .filter((r) => r.age_days >= 1 && r.age_days <= 8)\n  .map((r) => ({ json: { post_id: r.post_id, platform: r.platform, age_days: r.age_days, upload_response: r.upload_response } }));"
      },
      "id": "afca3939-b812-5253-a593-7f18d6049226",
      "name": "Posts to measure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('⚙️ Settings').first().json.UPLOADPOST_ANALYTICS_URL }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user",
              "value": "={{ $('⚙️ Settings').first().json.UPLOADPOST_USER }}"
            },
            {
              "name": "platform",
              "value": "={{ $json.platform }}"
            },
            {
              "name": "request_id",
              "value": "={{ (() => { try { const r = JSON.parse($json.upload_response); return r.request_id || r.id || ''; } catch (e) { return ''; } })() }}"
            }
          ]
        }
      },
      "id": "95b0fe8a-8162-5ef8-877a-5d19e4ea80e4",
